# Copie para .env.local e preencha com os dados do projeto no Supabase
# (Project Settings > API). A chave publicável pode ir para o navegador:
# quem protege os dados são as regras do banco (RLS).
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Endereço público do app (usado no link de login enviado por e-mail)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
